# services-status configuration template — committed, no secrets.
# Copy to `.env` and edit locally; `.env` is gitignored.
#
# The list of monitored processes is NOT here anymore — it moved to services.json
# at the project root, which is the single source of truth for both this server
# and systemd/generate.mjs. Add a service there, then `yarn systemd:install`.

# Port this monitor's own HTTP/WS server listens on.
PORT=2901

# Interface the server binds to. Loopback-only by default — see BIND_ALL below.
HOST=127.0.0.1

# Must be explicitly opted into to bind beyond loopback, and only takes effect
# together with a non-empty AUTH_TOKEN below. BIND_ALL=true with an empty
# AUTH_TOKEN refuses to start rather than serving the control panel unauthenticated.
BIND_ALL=false

# Set true when this sits behind a reverse proxy (nginx) that terminates TLS.
BEHIND_PROXY=false

# Protocol the proxy in front of this server terminates, for building absolute URLs.
PROXY_PROTOCOL=http

# Public hostname to use when BEHIND_PROXY=true; ignored otherwise.
DOMAIN=127.0.0.1

# systemctl/journalctl scope to query. This project only ever installs and
# manages user units — do not point it at "system" without also changing
# how the units are installed.
SYSTEMCTL_SCOPE=user

# How often the shared poller re-reads all unit states and broadcasts to
# every connected WebSocket client, in milliseconds.
POLL_INTERVAL_MS=2000

# Timeout for each TCP port-open probe, in milliseconds.
PROBE_TIMEOUT_MS=500

# Number of journal lines returned by a Logs request when the client does
# not ask for a specific count.
LOG_LINES=200

# Override for the workspace root services.json paths are resolved against.
# Leave unset to use the parent of this project directory (the default and
# the value every repo path in services.json assumes).
WORKSPACE_ROOT=

# Optional bearer token. Empty by default, which leaves the panel unauthenticated —
# acceptable only because the default bind is loopback. Required (see BIND_ALL)
# once this is reachable from anything other than localhost, since this page can
# start and stop every backend and frontend process on the platform.
AUTH_TOKEN=
