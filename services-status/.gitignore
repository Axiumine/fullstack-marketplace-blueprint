# services-status has no git repo of its own — the parent workspace's git is what reads this.

node_modules/
*.iml
.idea/
*.log*
.DS_Store
coverage/
reports/
.env
dist/
.yarnrc
.npmrc
uploads/
TODO
nohup.out
*.orig

# Generated by systemd/generate.mjs — overwritten on every run, never hand-edited.
systemd/units/
semgrep.sarif

# Stryker (yarn test:mutation). `reports/` above already covers the HTML report; this is
# the sandbox it copies the project into.
.stryker-tmp/

# Qodana — scan results (SARIF + report), written by the parent workspace's
# .githooks/pre-commit and pre-push. They pass --results-dir .qodana/results so the SARIF
# is readable from this directory after a failed gate, rather than from under
# ~/.cache/JetBrains/Qodana/<project-hash>/. Both are what the other twelve packages
# ignore; here they were left out, so every gate run made the tree dirty.
.qodana/

# Core dumps. Qodana's JS language service aborts on its 1 GB heap cap inside the scan container,
# and while the host's core_pattern is relative the kernel drops a ~1.3 GB `core.<pid>` here in the
# repo root — untracked, unignored, and large enough that `prettier --check .` fails on it with
# "Invalid string length" and takes the whole commit gate down. qodana.sh sweeps them after every
# scan; this is the second lock, so a crash costs a diagnosis rather than a red gate.
core
core.*
