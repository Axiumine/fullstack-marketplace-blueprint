{
  "name": "marketplace-services-status",
  "version": "1.0.0",
  "description": "Realtime monitor and control panel for the Marketplace platform's systemd user units",
  "main": "dist/server.js",
  "engines": {
    "node": "^24.18.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "scripts": {
    "build": "tsc",
    "postbuild": "yarn run copy-assets",
    "copy-assets": "cp -r src/public dist/",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "clean": "rm -rf dist",
    "systemd:generate": "node systemd/generate.mjs",
    "systemd:install": "./systemd/install.sh",
    "systemd:uninstall": "./systemd/uninstall.sh"
  },
  "dependencies": {
    "dotenv": "^17.0.1",
    "koa": "^2.14.2",
    "koa-router": "^12.0.0",
    "koa-static": "^5.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/koa": "^2.13.8",
    "@types/koa-router": "^7.4.4",
    "@types/koa-static": "^4.0.2",
    "@types/node": "^20.6.0",
    "@types/ws": "^8.5.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "marketplace",
    "systemd",
    "systemd-user-units",
    "process-monitor",
    "control-panel",
    "koa",
    "websocket",
    "typescript"
  ],
  "author": "",
  "license": "UNLICENSED"
}
