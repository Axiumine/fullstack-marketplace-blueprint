#!/usr/bin/env bash
# pre-commit — refuse to commit secret files or live secret values.
#
# Installed as a per-repo copy (not a symlink: nothing else can move out from
# under it). Three independent checks — check 0 reads the working tree,
# checks 1-2 the staged index:
#   0. a working-tree env line the parsers here disagree on -> block
#   1. staged PATH looks like a secret file            -> block
#   2. staged ADDED LINES contain a high-entropy secret -> block
#
# Patterns are deliberately narrow enough that the committed `env` / `npmrc`
# placeholder templates pass, and a line that is a self-declared placeholder
# (`KEY=test-…`) is dropped before the value scan. Override a verified false
# positive with:
#   git commit --no-verify
# Before any of them, one guard that is about the commit rather than its
# content: `main` is not a branch to commit onto (BCON-06, R35).
set -uo pipefail

# ---------------------------------------------------------------------------
# The branch, before anything else. BCON-06, RISK_REGISTER R35.
#
# `main` is the checked-out branch in all seventeen repos by default, and every
# rule on this platform says to branch before the first edit of any task.
# Nothing downstream caught the mistake until this block existed: a commit that
# lands on `main` passes every gate here, and untangling it afterwards is the
# one operation a shallow history makes expensive.
#
# It cannot fire on an ordinary merge. Git runs this hook for `git commit`
# only, so an automatic `--no-ff` merge commit never reaches it; the one merge
# that does is a conflicted one finished by hand, and `MERGE_HEAD` exists at
# exactly that moment. A detached HEAD — what `git submodule update` leaves
# behind — has no symbolic ref, so it is not this check's business either.
#
# The escape hatch is named rather than `--no-verify`, which would drop the
# secret guard below along with it. The first commit of a brand-new repo needs
# it, `git init` having started on `main` with nowhere else to be:
#   SKIP_MAIN_GUARD=1 git commit
if [ "$(git symbolic-ref --short HEAD 2> /dev/null || true)" = 'main' ] &&
	[ ! -f "$(git rev-parse --git-path MERGE_HEAD)" ] &&
	[ -z "${SKIP_MAIN_GUARD:-}" ]; then
	printf '\n  ✗ pre-commit: this commit would land on `main`.\n'
	printf '    Branch first:               git switch -c <type>/<slug>\n'
	printf '    Deliberate commit on main:  SKIP_MAIN_GUARD=1 git commit\n\n'
	exit 1
fi

fail=0

# ---------------------------------------------------------------------------
# Check 0 — an env value broken across two physical lines.
#
# dotenv ends a value at the newline *even inside quotes*, hands back the
# truncated prefix, and then parses the orphan tail — a bare fragment with no
# `KEY=` on it — as its own variable named after its first token. Both halves
# are silent: the service boots, its own suite stays green, and only a peer
# service that must agree on the value ever notices. On 2026-08-09 all five
# `.env` files holding `KEYGRIP_KEY_1`/`_2` were broken this way, 88-char keys
# wrapped after 76, one file carrying the tail twice.
#
# Quoting does not prevent it — every one of those values was correctly quoted
# — so the "quote anything with whitespace" convention (RISK_REGISTER R05) is
# not enough and this runs as a gate instead. R05b.
#
# The second half of the check is R05 itself: a value left UNQUOTED. Measured
# on this platform rather than assumed — `KEY=abc def` is `abc def` to dotenv
# 17.4.2 and an `invalid line` to direnv 2.32.1, which then exports none of the
# shared layer; `KEY=abc#tail` is `abc` to both, silently, because each reads
# the `#` as the start of a comment. One file, two readers, two answers, and
# the truncating one says nothing. A pair of quotes settles every case, so an
# unquoted value holding whitespace or a `#` is blocked here instead of being
# left to a convention that has now been broken twice.
#
# Measured again 2026-09-02, and the split half needed correcting too. dotenv
# 17.4.2 does not truncate a wrap inside quotes: it keeps both physical lines
# as one newline-bearing value, silently wrong rather than short. It truncates
# an unquoted wrap at the newline, and the orphan tail becomes a variable only
# when the tail carries an `=` - which base64 padding supplies. direnv 2.32.1
# refuses a wrap of any kind, quoted or not, and exports nothing at all from
# that file. So a tail like `kJ3xQ==` is a legal KEY=VALUE line to both readers
# and used to pass here. Two rules close it, and neither costs a false positive
# on the 706 keys that exist today: the key must be SCREAMING_SNAKE_CASE, and an
# unquoted value may not open with the `=` that base64 padding leaves behind.
#
# It reads the working tree, not the index, because the file it most needs to
# see is git-ignored and never staged. Line numbers and key names only: no
# value is ever printed, per .claude/SECRETS.md.
#
# A deliberate multi-line value (a PEM body, say) would trip this. None exists
# on this platform; if one is ever added, `git commit --no-verify`.
# ---------------------------------------------------------------------------
env_shape_ok() {
	local f="$1" n=0 line trimmed val q bad=0
	while IFS= read -r line || [ -n "$line" ]; do
		n=$((n + 1))
		trimmed="${line#"${line%%[![:space:]]*}"}"
		case "$trimmed" in '' | '#'*) continue ;; esac
		if [[ ! $trimmed =~ ^[A-Z][A-Z0-9_]*= ]]; then
			echo "pre-commit: $f:$n is not a SCREAMING_SNAKE KEY=VALUE line — the value above it is cut in two." >&2
			bad=1
			continue
		fi
		val="${trimmed#*=}"
		# Trailing whitespace only: both readers drop it, so there is nothing to
		# disagree about and flagging it would be a false positive on a stray space.
		val="${val%"${val##*[![:space:]]}"}"
		q="${val:0:1}"
		if [ "$q" = '"' ] || [ "$q" = "'" ]; then
			if [ "${#val}" -lt 2 ] || [ "${val: -1}" != "$q" ]; then
				echo "pre-commit: $f:$n — ${trimmed%%=*} opens a $q quote that never closes on this line." >&2
				bad=1
			fi
		elif [ -n "$val" ]; then
			case "$val" in
			'='*)
				echo "pre-commit: $f:$n — ${trimmed%%=*} opens its value with =, which is what base64 padding leaves on the tail of a split value." >&2
				bad=1
				;;
			*'#'*)
				echo "pre-commit: $f:$n — ${trimmed%%=*} is unquoted and holds a #, which both readers cut the value at." >&2
				bad=1
				;;
			*[[:space:]]*)
				echo "pre-commit: $f:$n — ${trimmed%%=*} is unquoted and holds whitespace, which direnv refuses outright." >&2
				bad=1
				;;
			esac
		fi
	done < "$f"
	return "$bad"
}

env_shape_fail=0
for envfile in .env .env.* env env.shared; do
	[ -f "$envfile" ] || continue
	env_shape_ok "$envfile" || env_shape_fail=1
done
if [ "$env_shape_fail" -ne 0 ]; then
	echo 'pre-commit: aborted — an env line above is not read the same way by every reader on this platform. A' >&2
	echo '            split value truncates and leaves a junk variable behind (R05b); an unquoted value holding' >&2
	echo '            whitespace or a # is refused by direnv or cut short by dotenv (R05); a tail that reads as its' >&2
	echo '            own KEY=VALUE line is still a tail (R05b). Rejoin it or quote it;' >&2
	echo '            no value was printed here. Why a gate: docs/workflow.md §Environment files.' >&2
	exit 1
fi

# ⚠️ Two of these are here because of RISK_REGISTER **R57**, and the first is a path rather than a
# shape. `setup/mongodb.js` is `marketplace-db-setup`'s provisioning runbook: it holds a live database
# credential by design and is kept out of git by one ignore line, so a deleted line or a `git add -f`
# is the whole distance between that credential and an object database nobody can rewrite cheaply.
# The `.key` extension came from `marketplace-nginx`'s copy of this hook, which carried it while the
# other fifteen did not — a rule in one hook is a rule in one repo, which is the drift §8 of
# `./scripts/audit-check.sh` now refuses for paths the way it already did for values. Neither costs
# anything: of the 2845 tracked files in the sixteen repos, none matches either, measured.
SECRET_PATH='(^|/)(\.env(\..*)?|\.envrc|\.npmrc|\.yarnrc|\.netrc|\.pgpass|id_rsa|id_dsa|id_ecdsa|id_ed25519|credentials\.json|service-account.*\.json)$|(^|/)setup/mongodb\.js$|\.(pem|key|p12|pfx|jks)$'
# Anything under a `secrets/` directory, whatever it is called. `marketplace-docker-DBs/secrets/` holds
# the replica-set keyfile, the CSFLE master key and now the generated Redis config, and the last of
# those is a plain-text file with no extension and no telltale name. The directory is git-ignored, so
# this rule only ever fires on a deliberate `git add -f` — which is exactly the case worth stopping.
# Nothing in these seventeen repos tracks a path with that segment, so it can cost nothing else.
SECRET_PATH+='|(^|/)secrets/'
# Yarn 4's `.yarnrc.yml` is committed on purpose (nodeLinker and the like) and so is let through by
# path above; its content is refused instead. It is also where a registry credential would go, so the
# loop below reads the whole staged file for one of these keys, at any indent, quoted or not.
YARNRC_CREDENTIAL='^[[:space:]]*["'"'"']?(npmAuthToken|npmAuthIdent|npmPassword|_auth|_authToken|_password)["'"'"']?[[:space:]]*:'

# Vendored secret-scanner rulesets legitimately contain example secret patterns.
SKIP_PATH='(^|/)(semgrep/vendor|gitleaks|trufflehog)/'

# High-entropy formats only. A placeholder (npm_xxxx, all-x, ${VAR}, empty) must
# never match, or the guard gets disabled by the first false positive.
SECRET_VALUE='npm_[A-Za-z0-9]{36}'
SECRET_VALUE+='|_authToken[[:space:]]*=[[:space:]]*["'"'"']?([0-9a-f]{8}-[0-9a-f]{4}-|ey[A-Za-z0-9_-]{10,}\.)'
SECRET_VALUE+='|-----BEGIN [A-Z ]*PRIVATE KEY-----'
SECRET_VALUE+='|KEYGRIP_KEY_[12][[:space:]]*=[[:space:]]*"[^x"]{40}'
# ADR-034's KEK, matched on its exact shape rather than on entropy: base64 of 32 bytes is 44 chars and
# always ends in '='. No `env` template placeholder has that shape — they are x's with no padding, or
# empty — so the rule cannot fire on one, and a real key cannot slip past by starting with an 'x' the
# way the [^x] rules above allow.
SECRET_VALUE+='|KEYGRIP_KEK[[:space:]]*=[[:space:]]*"?[A-Za-z0-9+/]{43}='
# dotenv style: KEY=<16+ chars>, at line start (a leading + from the diff is stripped first)
SECRET_VALUE+='|^[[:space:]]*(QODANA_TOKEN|SOCKETLABS_SERVER_APIKEY|SOCKETLABS_SERVER_ID|REDIS_PASSWORD|NPM_TOKEN)=[^$x[:space:]][^[:space:]]{15,}'
# code style: KEY = "<16+ chars>" — a quoted literal, never process.env.KEY
SECRET_VALUE+='|(QODANA_TOKEN|SOCKETLABS_SERVER_APIKEY|SOCKETLABS_SERVER_ID|REDIS_PASSWORD|NPM_TOKEN)[[:space:]]*[:=][[:space:]]*["'"'"'][^$x"'"'"'][^"'"'"']{15,}["'"'"']'
SECRET_VALUE+='|mongodb(\+srv)?://[^:/[:space:]]+:[^@[:space:]]{10,}@'
# A credential handed to a command line as a flag - `mongosh … -password <the value>`,
# `mysql --password=…`. No rule above can see one: there is no `KEY=` at the start of the line, no
# quoted assignment and no URI, which is exactly the shape RISK_REGISTER R14 was opened for. Three
# things keep it from firing on prose: the flag has to open its own word, so `reset-password material`
# in a comment is not a match; the value may not start with `$`, `x` or `<`, the three placeholder
# shapes written in these repos; and it must run 12 characters or more. Costs 0 false positives
# against every tracked file in all sixteen repos, measured before it landed.
SECRET_VALUE+='|(^|[[:space:]])-{1,2}(password|passwd|pwd|pass)[[:space:]=]+["'"'"']?[^$x<"'"'"'[:space:]][^[:space:]"'"'"']{11,}'
# redis.conf style: a `requirepass` or `masterauth` directive, which is how the Redis credential is
# spelled since the password stopped riding in the container's argv. There is no KEY= to match on and
# no fixed shape to the value, so the floor is the same 15 characters the dotenv rule uses, with the
# same first-character-not-x placeholder escape.
# Anchored at the line start: `requirepass` inside a sentence or a backticked word cannot trip it.
SECRET_VALUE+='|^[[:space:]]*(requirepass|masterauth)[[:space:]]+[^$x[:space:]][^[:space:]]{14,}'
# credential URL: `https://<userinfo>@host`, which is the shape of a Sentry/Bugsink DSN.
# `DSN` cannot join the key list above — the committed `env` template assigns one there, so a
# key-name rule would block the template itself. What separates the two is the userinfo: the
# placeholder is 14 `x`, a real key is 32+ hex. Hence first-char-not-x plus a 20-char floor.
SECRET_VALUE+='|https://[^$x:@/[:space:]"][^:@/[:space:]"]{19,}@'

# Declared-placeholder lines, dropped before the value scan: a whole line whose *only*
# content is `KEY=test-…` / `KEY: 'test-…'` (test fixtures in vitest.config.mts and friends).
# Anchored at both ends on purpose — it can never whitelist a secret that merely appears
# somewhere inside a URI, an object literal or a longer expression, only a line that is
# itself a self-declared placeholder assignment.
PLACEHOLDER='^[[:space:]]*[A-Za-z_][A-Za-z_0-9]*[[:space:]]*[:=][[:space:]]*'
PLACEHOLDER+='["'"'"']?(test|dummy|fake|sample|example|placeholder|changeme|your[-_])[A-Za-z_0-9:/.-]*["'"'"']?,?[[:space:]]*$'

# The `|| true` below absorbs grep's no-match exit 1 — it must not also absorb git's. A failed
# `git diff` yields an empty list, and an empty list is exactly what "nothing staged" looks like:
# the two loops would then scan nothing and the commit would pass by having read no files at all.
# So git's status is taken on its own line, before grep can hide it.
if ! all_staged="$(git diff --cached --name-only --diff-filter=ACMR)"; then
	echo 'pre-commit: `git diff --cached` failed — refusing to commit rather than scan nothing.' >&2
	exit 1
fi
staged=$(printf '%s\n' "$all_staged" | grep -Ev "$SKIP_PATH" || true)

while IFS= read -r f; do
	[ -n "$f" ] || continue
	if printf '%s\n' "$f" | grep -Eq "$SECRET_PATH"; then
		echo "pre-commit: refusing to commit secret file: $f" >&2
		fail=1
	fi
done <<< "$staged"

# The staged blob, whole file: a credential on a line this commit did not touch is still in the commit.
# Read into a variable and matched with a here-string, not piped into `grep -q` — the pipe would die of
# SIGPIPE under `pipefail` and a failed `git show` would read as "no credential"; here it fails closed.
while IFS= read -r f; do
	[ -n "$f" ] || continue
	[ "${f##*/}" = '.yarnrc.yml' ] || continue
	if ! yarnrc_blob="$(git show ":$f")"; then
		echo "pre-commit: refusing $f: could not read the staged blob to check it for a registry credential." >&2
		fail=1
	elif grep -Eq "$YARNRC_CREDENTIAL" <<< "$yarnrc_blob"; then
		echo "pre-commit: refusing $f: it carries a registry credential key (npmAuthToken, npmAuthIdent, npmPassword, _auth…). Those belong in ~/.yarnrc.yml, never in the repository." >&2
		fail=1
	fi
done <<< "$staged"

while IFS= read -r f; do
	[ -n "$f" ] || continue
	# Added lines only, with the diff's leading '+' stripped so ^-anchors work.
	if git diff --cached -U0 --diff-filter=ACMR -- "$f" | sed -n 's/^+//p' | grep -Eiv "$PLACEHOLDER" | grep -Eq "$SECRET_VALUE"; then
		echo "pre-commit: $f adds what looks like a live secret value." >&2
		fail=1
	fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
	echo 'pre-commit: aborted. Secrets belong in .env (git-ignored); commit only the `env` placeholder template.' >&2
	echo 'pre-commit: if this is genuinely a placeholder, re-run with: git commit --no-verify' >&2
	exit 1
fi

exit 0
