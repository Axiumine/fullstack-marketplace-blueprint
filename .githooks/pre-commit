#!/usr/bin/env bash
# pre-commit — refuse to commit secret files or live secret values.
#
# Installed as a per-repo copy (not a symlink: nothing else can move out from
# under it). Three independent checks — check 0 reads the working tree,
# checks 1-2 the staged index:
#   0. a working-tree env value is split across two lines -> block
#   1. staged PATH looks like a secret file            -> block
#   2. staged ADDED LINES contain a high-entropy secret -> block
#
# Patterns are deliberately narrow enough that the committed `env` / `npmrc`
# placeholder templates pass, and a line that is a self-declared placeholder
# (`KEY=test-…`) is dropped before the value scan. Override a verified false
# positive with:
#   git commit --no-verify
set -uo pipefail

fail=0

# ---------------------------------------------------------------------------
# Check 0 — an env value broken across two physical lines.
#
# dotenv ends a value at the newline *even inside quotes*, hands back the
# truncated prefix, and then parses the orphan tail — a bare fragment with no
# `KEY=` on it — as its own variable named after its first token. Both halves
# are silent: the service boots, its own suite stays green, and only a peer
# service that must agree on the value ever notices. On 2026-08-09 all five
# `.env` files holding `KEYGRIP_KEY_1`/`_2` were broken this way, 88-char keys
# wrapped after 76, one file carrying the tail twice.
#
# Quoting does not prevent it — every one of those values was correctly quoted
# — so the "quote anything with whitespace" convention (RISK_REGISTER R05) is
# not enough and this runs as a gate instead. R05b.
#
# It reads the working tree, not the index, because the file it most needs to
# see is git-ignored and never staged. Line numbers and key names only: no
# value is ever printed, per .claude/SECRETS.md.
#
# A deliberate multi-line value (a PEM body, say) would trip this. None exists
# on this platform; if one is ever added, `git commit --no-verify`.
# ---------------------------------------------------------------------------
env_shape_ok() {
	local f="$1" n=0 line trimmed val q bad=0
	while IFS= read -r line || [ -n "$line" ]; do
		n=$((n + 1))
		trimmed="${line#"${line%%[![:space:]]*}"}"
		case "$trimmed" in '' | '#'*) continue ;; esac
		if [[ ! $trimmed =~ ^[A-Za-z_][A-Za-z_0-9]*= ]]; then
			echo "pre-commit: $f:$n is not a KEY=VALUE line — the value above it is cut in two." >&2
			bad=1
			continue
		fi
		val="${trimmed#*=}"
		q="${val:0:1}"
		if [ "$q" = '"' ] || [ "$q" = "'" ]; then
			if [ "${#val}" -lt 2 ] || [ "${val: -1}" != "$q" ]; then
				echo "pre-commit: $f:$n — ${trimmed%%=*} opens a $q quote that never closes on this line." >&2
				bad=1
			fi
		fi
	done < "$f"
	return "$bad"
}

env_shape_fail=0
for envfile in .env .env.* env; do
	[ -f "$envfile" ] || continue
	env_shape_ok "$envfile" || env_shape_fail=1
done
if [ "$env_shape_fail" -ne 0 ]; then
	echo 'pre-commit: aborted — an env value is split across two lines. dotenv silently truncates it and turns the' >&2
	echo '            orphan tail into a junk variable. Rejoin the value onto one line; no value was printed here.' >&2
	echo '            Why this is a gate and not a convention: docs/workflow.md §Environment files, R05b.' >&2
	exit 1
fi

SECRET_PATH='(^|/)(\.env(\..*)?|\.envrc|\.npmrc|\.yarnrc(\.yml)?|\.netrc|\.pgpass|id_rsa|id_dsa|id_ecdsa|id_ed25519|credentials\.json|service-account.*\.json)$|\.(pem|p12|pfx|jks)$'

# Vendored secret-scanner rulesets legitimately contain example secret patterns.
SKIP_PATH='(^|/)(semgrep/vendor|gitleaks|trufflehog|\.gitnexus)/'

# High-entropy formats only. A placeholder (npm_xxxx, all-x, ${VAR}, empty) must
# never match, or the guard gets disabled by the first false positive.
SECRET_VALUE='npm_[A-Za-z0-9]{36}'
SECRET_VALUE+='|_authToken[[:space:]]*=[[:space:]]*["'"'"']?([0-9a-f]{8}-[0-9a-f]{4}-|ey[A-Za-z0-9_-]{10,}\.)'
SECRET_VALUE+='|-----BEGIN [A-Z ]*PRIVATE KEY-----'
SECRET_VALUE+='|KEYGRIP_KEY_[12][[:space:]]*=[[:space:]]*"[^x"]{40}'
# dotenv style: KEY=<16+ chars>, at line start (a leading + from the diff is stripped first)
SECRET_VALUE+='|^[[:space:]]*(QODANA_TOKEN|SOCKETLABS_SERVER_APIKEY|SOCKETLABS_SERVER_ID|REDIS_PASSWORD|INTROSPECTION_CODE|NPM_TOKEN)=[^$x[:space:]][^[:space:]]{15,}'
# code style: KEY = "<16+ chars>" — a quoted literal, never process.env.KEY
SECRET_VALUE+='|(QODANA_TOKEN|SOCKETLABS_SERVER_APIKEY|SOCKETLABS_SERVER_ID|REDIS_PASSWORD|INTROSPECTION_CODE|NPM_TOKEN)[[:space:]]*[:=][[:space:]]*["'"'"'][^$x"'"'"'][^"'"'"']{15,}["'"'"']'
SECRET_VALUE+='|mongodb(\+srv)?://[^:/[:space:]]+:[^@[:space:]]{10,}@'
# credential URL: `https://<userinfo>@host`, which is the shape of a Sentry/Bugsink DSN.
# `DSN` cannot join the key list above — the committed `env` template assigns one there, so a
# key-name rule would block the template itself. What separates the two is the userinfo: the
# placeholder is 14 `x`, a real key is 32+ hex. Hence first-char-not-x plus a 20-char floor.
SECRET_VALUE+='|https://[^$x:@/[:space:]"][^:@/[:space:]"]{19,}@'

# Declared-placeholder lines, dropped before the value scan: a whole line whose *only*
# content is `KEY=test-…` / `KEY: 'test-…'` (test fixtures in vitest.config.mts and friends).
# Anchored at both ends on purpose — it can never whitelist a secret that merely appears
# somewhere inside a URI, an object literal or a longer expression, only a line that is
# itself a self-declared placeholder assignment.
PLACEHOLDER='^[[:space:]]*[A-Za-z_][A-Za-z_0-9]*[[:space:]]*[:=][[:space:]]*'
PLACEHOLDER+='["'"'"']?(test|dummy|fake|sample|example|placeholder|changeme|your[-_])[A-Za-z_0-9:/.-]*["'"'"']?,?[[:space:]]*$'

# The `|| true` below absorbs grep's no-match exit 1 — it must not also absorb git's. A failed
# `git diff` yields an empty list, and an empty list is exactly what "nothing staged" looks like:
# the two loops would then scan nothing and the commit would pass by having read no files at all.
# So git's status is taken on its own line, before grep can hide it.
if ! all_staged="$(git diff --cached --name-only --diff-filter=ACMR)"; then
	echo 'pre-commit: `git diff --cached` failed — refusing to commit rather than scan nothing.' >&2
	exit 1
fi
staged=$(printf '%s\n' "$all_staged" | grep -Ev "$SKIP_PATH" || true)

while IFS= read -r f; do
	[ -n "$f" ] || continue
	if printf '%s\n' "$f" | grep -Eq "$SECRET_PATH"; then
		echo "pre-commit: refusing to commit secret file: $f" >&2
		fail=1
	fi
done <<< "$staged"

while IFS= read -r f; do
	[ -n "$f" ] || continue
	# Added lines only, with the diff's leading '+' stripped so ^-anchors work.
	if git diff --cached -U0 --diff-filter=ACMR -- "$f" | sed -n 's/^+//p' | grep -Eiv "$PLACEHOLDER" | grep -Eq "$SECRET_VALUE"; then
		echo "pre-commit: $f adds what looks like a live secret value." >&2
		fail=1
	fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
	echo 'pre-commit: aborted. Secrets belong in .env (git-ignored); commit only the `env` placeholder template.' >&2
	echo 'pre-commit: if this is genuinely a placeholder, re-run with: git commit --no-verify' >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# services-status — the one piece of application code this repo tracks.
#
# It is the odd one out on the platform: every other package lives in a git repo
# of its own and carries its own .githooks/, so its gates fire on its own
# commits. services-status has no repo — it is a subdirectory of this workspace —
# which left it with a qodana.yaml, a stryker.config.mjs, a 100% coverage
# threshold and NOTHING THAT RAN ANY OF THEM. The configs were the appearance of
# a gate, not a gate. This block is what makes them real, and pre-push carries
# the mutation half.
#
# Scoped by path on purpose: this repo's normal commit is a docs edit
# (CLAUDE.md, README.md, .claude/), and building + testing a Node server for a
# prose change is how a hook gets bypassed out of habit.
# ---------------------------------------------------------------------------

APP='services-status'

# Same reasoning as the secret guard above: unguarded, a failed `git diff` is
# indistinguishable from an empty one, and the empty one is the branch that exits
# 0 having run no gate at all.
if ! staged_all="$(git diff --cached --name-only --diff-filter=ACMRD)"; then
	echo 'pre-commit: `git diff --cached` failed — refusing to commit rather than skip the services-status gates.' >&2
	exit 1
fi

# Everything under the app EXCEPT its own docs. `systemd/` is in scope — its
# generator is JS the linter reads — and so is `semgrep/`, whose rules Qodana
# never sees but whose vendored ruleset the secret guard skips above.
# Two greps rather than one PCRE negative lookahead: `grep -P` is a GNU extension
# and the rest of this file is -E only, so the cheap portability is worth a pipe.
if ! printf '%s\n' "$staged_all" | grep -E "^$APP/" | grep -qvE '\.md$'; then
	exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
APP_DIR="$ROOT/$APP"

# $1 = what is wrong, $2… = the command(s) that fix it.
#
# A missing prerequisite blocks; it never warns and continues. A gate that steps
# aside when it cannot run is not a gate, it is the hole this hook exists to
# close, reopened one condition lower.
gate_block() {
	local reason="$1"
	shift
	{
		echo
		echo "pre-commit: BLOCKED — $reason"
		echo
		echo 'Fix it with:'
		echo
		printf '    %s\n' "$@"
		echo
		echo 'Bypass once (pre-push still gates): git commit --no-verify'
		echo
	} >&2
	exit 1
}

# `engines.node` is a HARD gate under yarn classic — a mismatch exits 1 with
# `The engine "node" is incompatible with this module`, not a warning. Read it
# from the app's package.json rather than from this repo, which has none.
REQUIRED_NODE="$(node -p "require('$APP_DIR/package.json').engines.node" 2> /dev/null | tr -d '^~>= ')"

if [ -z "$REQUIRED_NODE" ]; then
	gate_block "node not found in PATH — engines.node could not be read from $APP/package.json." \
		'nvm install --lts && nvm use --lts'
fi

node_satisfies() {
	local current
	current="$(node -v 2> /dev/null | tr -d 'v')"
	[ -n "$current" ] && [ -n "$REQUIRED_NODE" ] || return 1
	# caret semantics: same major, and not older than the pin.
	[ "${current%%.*}" = "${REQUIRED_NODE%%.*}" ] || return 1
	[ "$(printf '%s\n%s\n' "$REQUIRED_NODE" "$current" | sort -V | head -n 1)" = "$REQUIRED_NODE" ]
}

if ! node_satisfies; then
	# nvm.sh trips over unbound variables, so -u comes off around the source.
	NVM_SH="${NVM_DIR:-$HOME/.nvm}/nvm.sh"
	if [ -s "$NVM_SH" ]; then
		echo "pre-commit: node $(node -v 2> /dev/null) does not satisfy engines.node — switching via nvm."
		set +u
		# shellcheck disable=SC1090
		. "$NVM_SH" > /dev/null 2>&1 || true
		nvm use "$REQUIRED_NODE" > /dev/null 2>&1 || true
		set -u
	fi
fi

if ! node_satisfies; then
	gate_block "node $(node -v 2> /dev/null || echo '(not found)') does not satisfy engines.node ^$REQUIRED_NODE — yarn refuses to run at all." \
		"nvm install $REQUIRED_NODE && nvm use $REQUIRED_NODE"
fi

if ! command -v yarn > /dev/null 2>&1; then
	gate_block 'yarn not found in PATH — cannot run the coverage gate.' \
		'npm i -g yarn@1.22.22'
fi

cd "$APP_DIR" || gate_block "cannot enter $APP/." "git checkout $APP"

# No lint gate, and that is not an oversight: services-status is the one package
# here with no eslint.config.js and no .prettierrc. Its type check is not
# separate either — `test:cov` is `yarn build && vitest run --coverage`, so tsc
# runs first and a type error fails this gate before a single test does.
echo "pre-commit: $APP — building, testing and holding 100% coverage (yarn test:cov)…"

if ! yarn test:cov; then
	cat >&2 << 'EOF'

pre-commit: BLOCKED — services-status failed to build, failed its tests, or fell
below 100% coverage.

`test:cov` is `yarn build && vitest run --coverage`, so read the first error
above rather than the last: a tsc failure stops the run before any test executes.

vitest.config.mts gates every metric at 100. Nothing here needs live
infrastructure — systemctl and every probe target are stubbed — so a red run is a
real gap, never a missing service. The one suite that does reach out,
test/security.live.test.ts, boots the server on a loopback port and talks to
itself. Add the missing test; never lower the threshold.

Full report: services-status/coverage/index.html

Bypass once (pre-push still gates): git commit --no-verify
EOF
	exit 1
fi

echo "pre-commit: $APP — 100% coverage held."

if [ -n "${SKIP_QODANA:-}" ]; then
	echo 'pre-commit: Qodana gate skipped — SKIP_QODANA is set.' >&2
	exit 0
fi

if ! command -v qodana > /dev/null 2>&1; then
	gate_block 'the qodana CLI is not in PATH.' \
		'# install it, then re-run the commit:' \
		'https://github.com/JetBrains/qodana-cli#installation'
fi

if ! command -v docker > /dev/null 2>&1; then
	gate_block 'docker not found in PATH — the CLI runs the linter in a container.' \
		'# install Docker Engine, then re-run the commit:' \
		'https://docs.docker.com/engine/install/'
fi

if ! docker info > /dev/null 2>&1; then
	gate_block 'docker daemon not reachable.' \
		'sudo systemctl start docker'
fi

for required in qodana.yaml qodana.sh; do
	if [ ! -f "$APP_DIR/$required" ]; then
		gate_block "$APP/$required missing." \
			"git checkout $APP/$required"
	fi
done

# Checked separately from existence, because the failure it catches is indistinguishable
# from a real finding once it happens: a non-executable qodana.sh makes the invocation
# below exit non-zero having produced no results directory at all, and the block below
# reports that as "Qodana failed on services-status" with a link to a report that was
# never written. This app's copy was committed at mode 100644 while all eleven other
# repos' are 100755 — the mode is tracked by git, so it is restored on every clone.
if [ ! -x "$APP_DIR/qodana.sh" ]; then
	gate_block "$APP/qodana.sh is not executable — the scan would fail as a permission error and be reported as a finding." \
		"chmod +x $APP/qodana.sh" \
		"git update-index --chmod=+x $APP/qodana.sh"
fi

# Track the image declared in qodana.yaml rather than hard-coding a tag here, so
# bumping the version in one place cannot leave the hook scanning with an older
# linter than the manual runs use.
LINTER="$(grep -oE 'jetbrains/qodana-js:[0-9][0-9.]*' "$APP_DIR/qodana.yaml" | head -n 1 || true)"

if [ -z "$LINTER" ]; then
	gate_block "no 'jetbrains/qodana-js:<version>' image line found in $APP/qodana.yaml." \
		'# restore the `image:` key, then re-run the commit:' \
		"git checkout $APP/qodana.yaml"
fi

# The CLI would pull this itself. Blocking instead keeps a slow or unreachable
# Docker Hub from turning into a failed commit: one explicit pull per image bump,
# versus a network flake on any commit.
if ! docker image inspect "$LINTER" > /dev/null 2>&1; then
	gate_block "linter image $LINTER not present locally." \
		"docker pull $LINTER"
fi

# Metadata check only — no value is ever read here. qodana.sh loads the token into
# the process env without printing it, and accepts one that is already exported,
# which is why an exported token satisfies this check with no .env present.
if [ -z "${QODANA_TOKEN:-}" ] && { [ ! -f "$APP_DIR/.env" ] || ! grep -q '^[[:space:]]*QODANA_TOKEN=' "$APP_DIR/.env"; }; then
	gate_block "no QODANA_TOKEN, in the environment or in $APP/.env — Qodana 2023.2+ refuses to start without one." \
		'# create this app'"'"'s own project on https://qodana.cloud (never reuse another' \
		'# repo'"'"'s token — reports would land in that project and corrupt its baseline), then:' \
		"echo 'QODANA_TOKEN=<token>' >> $APP/.env"
fi

echo "pre-commit: $APP — running Qodana ($LINTER)…"

# SKIP_TESTS=1 reuses the coverage/lcov.info just written above instead of
# re-running the suite inside qodana.sh, which does it as `yarn test:cov || true`
# with the exit code swallowed.
if ! SKIP_TESTS=1 "$APP_DIR/qodana.sh" --results-dir "$APP_DIR/.qodana/results"; then
	cat >&2 << 'EOF'

pre-commit: BLOCKED — Qodana failed on services-status.

The gate lives in services-status/qodana.yaml: severityThresholds critical 0 /
high 0, plus testCoverageThresholds 100 total / 100 fresh. Findings are listed
above, with a report link on qodana.cloud.

Local SARIF: services-status/.qodana/results/qodana.sarif.json

This exit code also covers infrastructure failures (daemon died mid-scan, out of
disk). If the report shows no findings, it was not a finding.

Bypass once (coverage and pre-push still gate): SKIP_QODANA=1 git commit
EOF
	exit 1
fi

echo "pre-commit: $APP — Qodana clean. Proceeding with commit."
exit 0
